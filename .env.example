# Copy to .env.local (gitignored) to override for local dev.

# Enable the Water Metro as a live, enterable experience.
# Unset / not "true"  -> landing shows "Coming soon", #/water redirects home.
# "true"              -> full Water Metro (tracker, boats, routes).
# Production (main) leaves this unset; set it on the `water` branch's deploy.
VITE_WATER_METRO=false
